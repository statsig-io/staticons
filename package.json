{
  "name": "staticons",
  "version": "1.0.0",
  "description": "Monorepo for packaging Statsig Product Icons a.k.a Staticons for various frameworks",
  "main": "dist/index.js",
  "scripts": {
    "build:lib": "pnpm --dir internal/lib build",
    "build:scripts": "pnpm --dir internal/scripts build",
    "build:react": "pnpm --dir packages/staticons-react build",
    "build:site": "pnpm --dir site build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statsig-io/staticons.git"
  },
  "author": "Statsig <support@statsig.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/statsig-io/staticons/issues"
  },
  "homepage": "https://github.com/statsig-io/staticons#readme",
  "workspaces": [
    "packages/*",
    "internal/*",
    "site/*"
  ],
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "@types/typescript": "^2.0.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "pnpm": {
    "overrides": {
      "liquidjs": "^10.26.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "glob@10": "^10.5.0",
      "glob@11": "^11.1.0",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "linkify-it": "^5.0.2",
      "minimatch@3": "^3.1.3",
      "minimatch@9": "^9.0.7",
      "minimatch@10": "^10.2.3",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.18",
      "rollup": "^4.59.0",
      "ws": "^8.21.0"
    }
  },
  "private": true
}
